/**
 * @file version.h
 * @brief nvecd version information, generated from the CMake project version
 */

#pragma once

#include <string>

namespace nvecd {

/**
 * @brief Version information
 */
class Version {
 public:
  /**
   * @brief Get version string
   * @return Version string (e.g., "0.4.0")
   */
  static std::string String() { return "@PROJECT_VERSION@"; }

  /**
   * @brief Get major version
   */
  static int Major() { return @PROJECT_VERSION_MAJOR@; }

  /**
   * @brief Get minor version
   */
  static int Minor() { return @PROJECT_VERSION_MINOR@; }

  /**
   * @brief Get patch version
   */
  static int Patch() { return @PROJECT_VERSION_PATCH@; }
};

}  // namespace nvecd
